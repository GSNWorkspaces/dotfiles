#!/usr/bin/env bash

set -Eeuo pipefail

echo "Executando setup com o Bash ..."

export PATH="$HOME/.local/bin:$HOME/.pixi/bin:$PATH"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

if ! command_exists curl; then
  printf '%s\n' \
    'curl não está instalado. Execute o script de build primeiro.' >&2
  exit 1
fi

if command_exists uv; then
  printf 'uv já instalado: %s\n' "$(uv --version)" >&2
else
  curl --fail --silent --show-error --location \
    https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
fi

if command_exists pixi; then
  printf 'pixi já instalado: %s\n' "$(pixi --version)" >&2
else
  curl --fail --silent --show-error --location \
    https://pixi.sh/install.sh | sh
  export PATH="$HOME/.pixi/bin:$PATH"
fi

if command_exists rustup; then
  printf 'rustup já instalado: %s\n' "$(rustup --version)" >&2
else
  curl --fail --silent --show-error --location \
    https://sh.rustup.rs | sh -s -- -y
fi

if [[ -f "$HOME/.cargo/env" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi

printf '\nInstalação concluída:\n'
uv --version
pixi --version
rustup --version
